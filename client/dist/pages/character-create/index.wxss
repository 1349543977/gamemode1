.create-page{background:var(--color-background);min-height:100vh;padding:var(--spacing-lg)}.create-page__title{color:var(--color-text);display:block;font-size:var(--font-xl);font-weight:700;margin-bottom:var(--spacing-xl)}.create-page__form{margin-bottom:var(--spacing-xl)}.form-field{margin-bottom:var(--spacing-lg)}.form-field__label{color:var(--color-text);display:block;font-size:var(--font-md);font-weight:600;margin-bottom:var(--spacing-sm)}.form-field__input{background:var(--color-surface);border:2rpx solid var(--color-border);border-radius:var(--radius-md);color:var(--color-text);font-size:var(--font-md);height:80rpx;padding:0 var(--spacing-md);width:100%}.form-field__picker{background:var(--color-surface);border:2rpx solid var(--color-border);border-radius:var(--radius-md);color:var(--color-text);font-size:var(--font-md);height:80rpx;line-height:80rpx;padding:0 var(--spacing-md)}