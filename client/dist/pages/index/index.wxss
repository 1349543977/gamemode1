.character-card{background:var(--color-surface);border-radius:var(--radius-lg);-webkit-box-shadow:0 2rpx 4rpx rgba(0,0,0,.05);box-shadow:0 2rpx 4rpx rgba(0,0,0,.05);margin-bottom:var(--spacing-md);padding:var(--spacing-md)}.character-card__header{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;-webkit-align-items:center;justify-content:space-between;-ms-flex-align:center;align-items:center;margin-bottom:var(--spacing-sm)}.character-card__name{color:var(--color-text);font-size:var(--font-lg);font-weight:600}.character-card__status{border-radius:var(--radius-full);font-size:var(--font-xs);padding:4rpx 16rpx}.character-card__status--alive{background:rgba(16,185,129,.1);color:var(--color-success)}.character-card__status--dead{background:rgba(239,68,68,.1);color:var(--color-danger)}.character-card__info{display:-webkit-flex;display:-ms-flexbox;display:flex;gap:var(--spacing-md);margin-bottom:var(--spacing-sm)}.character-card__age,.character-card__city,.character-card__stage{color:var(--color-text-secondary);font-size:var(--font-sm)}.character-card__stats{margin-top:var(--spacing-sm)}.stat-bar{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;margin-bottom:8rpx}.stat-bar__label{color:var(--color-text-secondary);font-size:var(--font-xs);width:80rpx}.stat-bar__track{background:var(--color-surface-variant);border-radius:5rpx;-webkit-flex:1;-ms-flex:1;flex:1;height:10rpx;overflow:hidden}.stat-bar__fill{border-radius:5rpx;height:100%;-webkit-transition:width .3s ease;transition:width .3s ease}.index-page{background:var(--color-background);min-height:100vh;padding:var(--spacing-md)}.index-page__header{margin-bottom:var(--spacing-lg)}.index-page__greeting{color:var(--color-text);display:block;font-size:var(--font-xl);font-weight:700}.index-page__subtitle{color:var(--color-text-secondary);display:block;font-size:var(--font-md);margin-top:var(--spacing-xs)}.index-page__skeleton .skeleton-card{-webkit-animation:pulse 1.5s ease-in-out infinite;animation:pulse 1.5s ease-in-out infinite;background:var(--color-surface-variant);border-radius:var(--radius-lg);height:200rpx;margin-bottom:var(--spacing-md)}.index-page__list{margin-bottom:160rpx}.index-page__empty{color:var(--color-text-secondary);display:block;font-size:var(--font-md);padding:80rpx 0;text-align:center}.index-page__footer{background:var(--color-background);bottom:0;-webkit-box-shadow:0 -2rpx 10rpx rgba(0,0,0,.05);box-shadow:0 -2rpx 10rpx rgba(0,0,0,.05);left:0;padding:var(--spacing-md);position:fixed;right:0}@-webkit-keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}