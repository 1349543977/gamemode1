.login-page{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;min-height:100vh;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;background:-webkit-linear-gradient(315deg,#6366f1,#8b5cf6);background:linear-gradient(135deg,#6366f1,#8b5cf6);justify-content:center;padding:var(--spacing-xl)}.login-page__header{margin-bottom:120rpx;text-align:center}.login-page__title{color:#fff;display:block;font-size:72rpx;font-weight:800}.login-page__subtitle{color:hsla(0,0%,100%,.8);display:block;font-size:var(--font-md);margin-top:var(--spacing-sm)}.login-page__actions{max-width:500rpx;width:100%}.login-page__btn{background:#07c160;border:none;border-radius:var(--radius-lg);color:#fff;font-size:var(--font-md);font-weight:600;height:88rpx;width:100%}