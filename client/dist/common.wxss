.loading-btn{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;border-radius:var(--radius-lg);font-weight:600;justify-content:center;-webkit-transition:opacity .2s;transition:opacity .2s}.loading-btn--primary{background:var(--color-primary);color:#fff}.loading-btn--secondary{background:var(--color-surface-variant);color:var(--color-text)}.loading-btn--danger{background:var(--color-danger);color:#fff}.loading-btn--sm{font-size:var(--font-sm);padding:16rpx 32rpx}.loading-btn--md{font-size:var(--font-md);padding:20rpx 40rpx}.loading-btn--lg{font-size:var(--font-lg);padding:28rpx 56rpx}.loading-btn--disabled{opacity:.6;pointer-events:none}.loading-btn__spinner{-webkit-animation:spin .6s linear infinite;animation:spin .6s linear infinite;border:4rpx solid hsla(0,0%,100%,.3);border-radius:50%;border-top-color:#fff;height:28rpx;margin-right:12rpx;width:28rpx}.loading-btn__text{line-height:1}@-webkit-keyframes spin{to{-webkit-transform:rotate(1turn);transform:rotate(1turn)}}@keyframes spin{to{-webkit-transform:rotate(1turn);transform:rotate(1turn)}}